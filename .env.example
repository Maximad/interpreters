# Public images used by Docker Compose / Docker Manager
IMAGE_API=ghcr.io/your-org/interpreters-api:latest
IMAGE_WEB=ghcr.io/your-org/interpreters-web:latest
IMAGE_NGINX=ghcr.io/your-org/interpreters-nginx:latest

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=interpreter_marketplace
DATABASE_URL=postgresql://postgres:change_me@postgres:5432/interpreter_marketplace?schema=public

JWT_SECRET=change_me
JWT_EXPIRES_IN=1h
CORS_ORIGINS=https://interpreters.jwtalenthouse.com

REDIS_URL=redis://redis:6379
MEILISEARCH_URL=http://meilisearch:7700
MEILI_MASTER_KEY=change_me
MEILISEARCH_API_KEY=change_me
MEILISEARCH_INTERPRETERS_INDEX=interpreters

NEXT_PUBLIC_API_BASE_URL=/api

SEARCH_SYNC_INTERVAL_MS=30000
NOTIFICATION_QUEUE_INTERVAL_MS=10000
NOTIFICATION_BATCH_SIZE=50
DAILY_DIRECT_INQUIRY_LIMIT=30
DAILY_BROADCAST_LIMIT=20
BROADCAST_RECIPIENT_CAP=50
