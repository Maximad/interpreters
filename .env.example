# Image/registry settings used by docker compose
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=your-org/interpreters
IMAGE_TAG=latest

# Public domain used by your external proxy/gateway
APP_DOMAIN=interpreters.example.com

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=interpreter_marketplace
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/interpreter_marketplace?schema=public

JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

MEILI_MASTER_KEY=change-me

# Optional public runtime overrides
NEXT_PUBLIC_API_BASE_URL=/api

# Put any provider/API keys here (do not commit real values)
THIRD_PARTY_API_KEY=change-me
